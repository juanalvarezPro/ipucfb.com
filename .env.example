# ── Neon (https://console.neon.tech → Connection details) ──
# Pooled (con -pooler en el host): la usa la app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/ipucfb?sslmode=require"
# Directa (sin -pooler): la usa `prisma migrate`
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/ipucfb?sslmode=require"

# ── Wasapi (https://app.wasapi.io → Integraciones → API) ──
WASAPI_API_KEY=""
# Id de la línea de WhatsApp de la iglesia (list_whatsapp_numbers → id)
WASAPI_FROM_ID=""
# (Opcional) plantilla aprobada que recibe quien escribe desde la página.
#   Variable {{1}} = nombre de la persona.
WASAPI_WELCOME_TEMPLATE_ID=""
# (Opcional) plantilla que avisa al equipo pastoral de cada solicitud nueva.
#   {{1}} = tipo, {{2}} = nombre, {{3}} = teléfono, {{4}} = mensaje
WASAPI_TEAM_TEMPLATE_ID=""
# Números del equipo pastoral separados por coma (573001234567,573009876543)
WASAPI_TEAM_PHONES=""

# URL pública (para metadatos y OG)
NEXT_PUBLIC_SITE_URL="https://ipucfb.com"
