// Base de datos de ipucfb.com — Postgres en Neon.
// DATABASE_URL = conexión pooled (la usa la app); DIRECT_URL = directa (migraciones).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RequestKind {
  PRAYER // petición de oración
  VISIT // quiero visitar la iglesia
  CONTACT // mensaje general
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  DONE
}

/// Lo que llega desde los formularios de la página.
model ContactRequest {
  id        String        @id @default(cuid())
  kind      RequestKind
  status    RequestStatus @default(NEW)
  name      String
  phone     String // E.164 sin "+": 573001234567
  message   String?
  /// La persona pidió que su petición no se comparta en público.
  private   Boolean       @default(true)
  /// Resultado de la sincronización con Wasapi (contacto + plantilla).
  wasapiOk  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([kind, status, createdAt])
}

/// Cultos y reuniones de la semana (se pinta en la sección "Horarios").
model Service {
  id        String  @id @default(cuid())
  title     String
  /// 0 = domingo … 6 = sábado
  dayOfWeek Int
  /// "07:00 p. m."
  time      String
  note      String?
  order     Int     @default(0)
  active    Boolean @default(true)

  @@index([active, order])
}

/// Eventos especiales (vigilias, convenciones, bautismos…).
model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  place       String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([published, startsAt])
}

/// Inscripción de jóvenes y adolescentes (encuesta de /jovenes).
model YouthRegistration {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Quién eres ──
  firstName    String
  lastName     String
  nickname     String? /// ¿Cómo te gusta que te digan?
  birthDate    DateTime @db.Date /// Cumpleaños
  gender       String? /// hombre | mujer
  whatsapp     String /// E.164 sin "+": 573001234567
  instagram    String?
  neighborhood String? /// Barrio / municipio
  occupation   String? /// colegio | universidad | tecnico | trabajo | otro
  institution  String? /// Colegio, universidad o empresa
  grade        String? /// Grado o semestre

  // ── Acudiente (obligatorio si es menor de 18) ──
  guardianName     String?
  guardianPhone    String?
  guardianRelation String?

  // ── Tu caminar con Dios ──
  timeInChurch  String? /// nuevo | menos-1 | 1-3 | mas-3 | toda-la-vida
  howArrived    String? /// familia | amigo | redes | evento | otro
  baptized      String? /// si | no | quiero
  holySpirit    String? /// si | no | buscando
  familyAttends String? /// si | algunos | no

  // ── Lo que te gusta ──
  musicGenres     String[]
  favoriteArtists String?
  hobbies         String[]
  favoriteSport   String?
  favoriteFood    String?
  favoriteSocial  String?

  // ── Tus dones ──
  talents      String[]
  instrument   String?
  wantsToServe String[]

  // ── Lo que quieres vivir ──
  activities      String[]
  topics          String[]
  fridayAvailable String? /// si | a-veces | no
  dreams          String? /// ¿Qué sueñas para tu vida?

  // ── Confidencial (solo la directiva) ──
  prayerRequest String?
  forLeaders    String?

  // ── Autorizaciones ──
  dataConsent  Boolean /// Ley 1581 de 2012
  imageConsent Boolean @default(false)

  @@index([createdAt])
  @@index([birthDate])
}
